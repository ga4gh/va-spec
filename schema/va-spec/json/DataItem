{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/ga4gh/schema/va-spec/1.1.0-ballot.2026-09.1/json/DataItem",
   "title": "DataItem",
   "maturity": "draft",
   "description": "An Information Entity representing an individual piece of data, generated or acquired through methods which reliably produce truthful information about something.",
   "properties": {
      "id": {
         "type": "string",
         "description": "The 'logical' identifier of the Entity in the system of record, e.g. a UUID.  This 'id' is unique within a given system, but may or may not be globally unique outside the system. It is used within a system to reference an object from another."
      },
      "type": {
         "type": "string",
         "description": "Must be \"DataItem\"",
         "const": "DataItem",
         "default": "DataItem"
      },
      "name": {
         "type": "string",
         "description": "A primary name for the entity."
      },
      "description": {
         "type": "string",
         "description": "A free-text description of the Entity."
      },
      "aliases": {
         "type": "array",
         "ordered": false,
         "items": {
            "type": "string"
         },
         "description": "Alternative name(s) for the Entity."
      },
      "extensions": {
         "type": "array",
         "ordered": false,
         "items": {
            "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/Extension"
         },
         "description": "A list of extensions to the Entity, that allow for capture of information not directly supported by elements defined in the model."
      },
      "specifiedBy": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/va-spec/1.1.0-ballot.2026-09.1/json/Method"
            },
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            }
         ],
         "description": "A specification that describes all or part of the process that led to creation of the Information Entity"
      },
      "contributions": {
         "type": "array",
         "ordered": true,
         "items": {
            "$ref": "/ga4gh/schema/va-spec/1.1.0-ballot.2026-09.1/json/Contribution"
         },
         "description": "Specific actions taken by an Agent toward the creation, modification, validation, or deprecation of an Information Entity."
      },
      "reportedIn": {
         "type": "array",
         "ordered": false,
         "items": {
            "oneOf": [
               {
                  "$ref": "/ga4gh/schema/va-spec/1.1.0-ballot.2026-09.1/json/Document"
               },
               {
                  "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
               }
            ]
         },
         "description": "A document in which the the Information Entity is reported."
      },
      "value": {
         "description": "The value of the data item (could be a structured value, a quantitative or qualitative value, or an IRI reference to either).",
         "anyOf": [
            {
               "type": "object"
            },
            {
               "type": "string"
            },
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            }
         ]
      }
   },
   "type": "object",
   "required": [
      "type"
   ],
   "additionalProperties": false
}
