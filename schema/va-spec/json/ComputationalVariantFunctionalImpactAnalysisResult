{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/ga4gh/schema/va-spec/1.1.0-ballot.2026-09.1/json/ComputationalVariantFunctionalImpactAnalysisResult",
   "title": "ComputationalVariantFunctionalImpactAnalysisResult",
   "maturity": "draft",
   "description": "An AnalysisResult that reports the output of a single in silico tool's analysis of a variant's functional impact, including any numeric score(s) and optional categorical interpretation.",
   "properties": {
      "id": {
         "type": "string",
         "description": "The 'logical' identifier of the Entity in the system of record, e.g. a UUID.  This 'id' is unique within a given system, but may or may not be globally unique outside the system. It is used within a system to reference an object from another."
      },
      "type": {
         "type": "string",
         "description": "MUST be \"ComputationalVariantFunctionalImpactAnalysisResult\".",
         "const": "ComputationalVariantFunctionalImpactAnalysisResult",
         "default": "ComputationalVariantFunctionalImpactAnalysisResult"
      },
      "name": {
         "type": "string",
         "description": "A primary name for the entity."
      },
      "description": {
         "type": "string",
         "description": "A free-text description of the Entity."
      },
      "aliases": {
         "type": "array",
         "ordered": false,
         "items": {
            "type": "string"
         },
         "description": "Alternative name(s) for the Entity."
      },
      "extensions": {
         "type": "array",
         "ordered": false,
         "items": {
            "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/Extension"
         },
         "description": "A list of extensions to the Entity, that allow for capture of information not directly supported by elements defined in the model."
      },
      "specifiedBy": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/va-spec/1.1.0-ballot.2026-09.1/json/Method"
            }
         ],
         "description": "The in silico method or algorithm that was applied to generate the reported score(s)."
      },
      "contributions": {
         "type": "array",
         "ordered": true,
         "items": {
            "$ref": "/ga4gh/schema/va-spec/1.1.0-ballot.2026-09.1/json/Contribution"
         },
         "description": "Specific actions taken by an Agent toward the creation, modification, validation, or deprecation of this Information Entity."
      },
      "reportedIn": {
         "type": "array",
         "ordered": false,
         "items": {
            "oneOf": [
               {
                  "$ref": "/ga4gh/schema/va-spec/1.1.0-ballot.2026-09.1/json/Document"
               },
               {
                  "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
               }
            ]
         },
         "description": "A document in which the the Information Entity is reported."
      },
      "focus": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/vrs/2.1.1-ballot.2026-09.1/json/Allele"
            },
            {
               "$ref": "/ga4gh/schema/cat-vrs/1.1.1-ballot.2026-09.1/json/CategoricalVariant"
            }
         ],
         "description": "The genetic variant for which the in silico analysis was performed."
      },
      "sourceDataSet": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/va-spec/1.1.0-ballot.2026-09.1/json/DataSet"
            },
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            }
         ],
         "description": "The dataset from which the in silico scores were retrieved or derived (e.g., an Ensembl VEP annotation dataset)."
      },
      "ancillaryResults": {
         "maturity": "draft",
         "description": "An object in which implementers can define custom fields to capture additional scores or outputs produced by the in silico tool beyond the primary score. For example, CADD reports both a raw score and a Phred-scaled score; the primary score field would hold one, and ancillaryResults would hold the other.",
         "type": "object",
         "additionalProperties": true
      },
      "qualityMeasures": {
         "maturity": "draft",
         "description": "An object in which implementers can define custom fields to capture metadata about the quality/provenance of the primary data items captured in standard attributes in the main body of the Study Result. e.g. a sequencing coverage metric in a Cohort Allele Frequency Study Result.",
         "type": "object",
         "additionalProperties": true
      },
      "transcriptVariationContext": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/vrs/2.1.1-ballot.2026-09.1/json/Allele"
            }
         ],
         "description": "The transcript in the context of which the in silico analysis was performed."
      },
      "impactScore": {
         "type": "number",
         "description": "The primary numeric score produced by the in silico tool for this variant."
      },
      "impactScoreType": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/MappableConcept"
            }
         ],
         "description": "A descriptor indicating what the score represents (e.g., 'SIFT impact score', 'CADD Phred-scaled impact score')."
      },
      "categoricalImpact": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/MappableConcept"
            }
         ],
         "description": "The categorical interpretation derived from the score by the in silico tool (e.g., 'tolerated', 'benign', 'pathogenic')."
      },
      "impactedFeatureType": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/MappableConcept"
            }
         ],
         "description": "A descriptor indicating the type of feature for which the focus variant has a predicted impact"
      },
      "impactedFeature": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/gkm-core/1.3.0-ballot.2026-09.1/json/MappableConcept"
            }
         ],
         "description": "The specific feature for which the focus variant has a predicted impact"
      }
   },
   "required": [
      "focus",
      "impactScore",
      "transcriptVariationContext",
      "type"
   ],
   "type": "object",
   "additionalProperties": false
}
