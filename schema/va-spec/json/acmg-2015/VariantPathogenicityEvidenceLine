                  "primaryCoding": {
                     "code": {
                        "pattern": "^(?:no_criteria_met|((?:PVS1)(?:_(?:not_met|(?:strong|moderate|supporting)))?|(?:PS[1-4]|BS[1-4])(?:_(?:not_met|(?:very_strong|moderate|supporting)))?|BA1(?:_not_met)?|(?:PM[1-6])(?:_(?:not_met|(?:very_strong|strong|supporting)))?|(PP[1-5]|BP[1-7])(?:_(?:not_met|very_strong|strong|moderate))?))$",
                        "example": "PS3, PS3_moderate, PS3_not_met, BP6, BP6_strong, BP6_not_met, no_criteria_met",
                        "description": "The code for the evidence outcome, which is based on the ACMG criterion code, used, and the assessed direction and strength of evidence provided."
                     },
                     "system": {
                        "const": "ACMG Guidelines, 2015"
                     }
                  }
               }
            }
