      "traits": {
         "type": "array",
         "ordered": false,
         "items": {
            "$ref": "/ga4gh/schema/gks-core/1.0.0-snapshot.2024-11.1/json/MappableConcept"
         },
         "description": "A list of conditions (diseases, phenotypes, traits) that are co-occurring.",
