{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://w3id.org/ga4gh/schema/va-spec/1.0.1/base/json/ComputationalVariantFunctionalImpactAnalysisResult",
   "title": "ComputationalVariantFunctionalImpactAnalysisResult",
   "maturity": "draft",
   "type": "object",
   "description": "An AnalysisResult that reports the output of a single in silico tool's analysis of a variant's functional impact, including any numeric score(s) and optional categorical interpretation.",
   "properties": {
      "id": {
         "type": "string",
         "description": "The 'logical' identifier of the Entity in the system of record, e.g. a UUID. This 'id' is unique within a given system, but may or may not be globally unique outside the system. It is used within a system to reference an object from another.",
         "$comment": "Note that it is common for implementers to create their own internal logical ids - typically a serially or randomly generated value like a UUID that is assigned to the data object as it is created in a system. But an implementer may choose to re-use an existing, globally unique id from an external system or authority for this purpose (e.g. an HGNC id for a Gene object) - as long as it is unique within the implementing system, and can be used to reference the identified object in this context."
      },
      "name": {
         "type": "string",
         "description": "A primary name for the entity."
      },
      "description": {
         "type": "string",
         "description": "A free-text description of the Entity."
      },
      "aliases": {
         "type": "array",
         "ordered": false,
         "items": {
            "type": "string"
         },
         "description": "Alternative name(s) for the Entity."
      },
      "extensions": {
         "type": "array",
         "ordered": false,
         "items": {
            "$ref": "/ga4gh/schema/gks-core/1.0.0/json/Extension"
         },
         "description": "A list of extensions to the Entity, that allow for capture of information not directly supported by elements defined in the model.",
         "$comment": "Extension objects have a key-value data structure that allows definition of custom fields in the data itself. Extensions are not expected to be natively understood, but may be used for pre-negotiated exchange of message attributes between systems."
      },
      "type": {
         "type": "string",
         "description": "MUST be \"ComputationalVariantFunctionalImpactAnalysisResult\".",
         "$comment": "MUST be the name of a concrete class from the data model.",
         "const": "ComputationalVariantFunctionalImpactAnalysisResult",
         "default": "ComputationalVariantFunctionalImpactAnalysisResult"
      },
      "focusVariant": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/vrs/2.0.1/json/Allele"
            },
            {
               "$ref": "/ga4gh/schema/cat-vrs/1.0.0/json/CategoricalVariant"
            }
         ],
         "description": "The genetic variant for which the in silico analysis was performed.",
         "$comment": "The 'focus' of a AnalysisResult is what anchors selection of all data items and provenance information that it contains. For computational predictions, this will typically be a genomic allele, though categorical variants are also supported."
      },
      "transcriptVariationContext": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/vrs/2.0.1/json/Allele"
            }
         ],
         "description": "The transcript in the context of which the in silico analysis was performed.",
         "$comment": "We may update this to an array to allow multiple Allele objects that are part of the same genomic variation to specify a single score"
      },
      "impactScore": {
         "type": "number",
         "description": "The primary numeric score produced by the in silico tool for this variant."
      },
      "impactScoreType": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/MappableConcept"
            }
         ],
         "description": "A descriptor indicating what the score represents (e.g., 'SIFT impact score', 'CADD Phred-scaled impact score')."
      },
      "categoricalImpact": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/MappableConcept"
            }
         ],
         "description": "The categorical interpretation derived from the score by the in silico tool (e.g., 'tolerated', 'benign', 'pathogenic')."
      },
      "impactedFeatureType": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/MappableConcept"
            }
         ],
         "description": "A descriptor indicating the type of feature for which the focus variant has a predicted impact"
      },
      "impactedFeature": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/iriReference"
            },
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/MappableConcept"
            }
         ],
         "description": "The specific feature for which the focus variant has a predicted impact",
         "$comment": "This should align with the impacted feature type i.e., if you specify a feature type of Gene, a Gene should be specified in this field"
      },
      "ancillaryResults": {
         "maturity": "draft",
         "description": "An object in which implementers can define custom fields to capture additional scores or outputs produced by the in silico tool beyond the primary score. For example, CADD reports both a raw score and a Phred-scaled score; the primary score field would hold one, and ancillaryResults would hold the other.",
         "$comment": "This field is left at draft maturity, as it differs from most GKS objects by allowing any content to be added.",
         "type": "object",
         "additionalProperties": true
      },
      "specifiedBy": {
         "oneOf": [
            {
               "$ref": "/ga4gh/schema/va-spec/1.0.1/base/json/Method"
            },
            {
               "$ref": "/ga4gh/schema/gks-core/1.0.0/json/iriReference"
            }
         ],
         "description": "The in silico method or algorithm that was applied to generate the reported score(s).",
         "$comment": "Examples: a specific version of SIFT, PolyPhen-2, or CADD described in a referenced publication. Note that this attribute captures a specific instance of a method (e.g., SIFT as described in https://doi.org/10.1038/nmeth.3328) rather than a type of method."
      },
      "contributions": {
         "type": "array",
         "ordered": true,
         "items": {
            "$ref": "/ga4gh/schema/va-spec/1.0.1/base/json/Contribution"
         },
         "description": "Specific actions taken by an Agent toward the creation, modification, validation, or deprecation of this Information Entity.",
         "$comment": "This attribute holds one or more Contribution objects, which provide structured descriptions of a contribution made to the Information Entity by a particular agent."
      },
      "sourceDataSet": {
         "$ref": "/ga4gh/schema/va-spec/1.0.1/base/json/DataSet",
         "description": "The dataset from which the in silico scores were retrieved or derived (e.g., an Ensembl VEP annotation dataset).",
         "$comment": "This property is most relevant when the AnalysisResult is used as a standalone representation, where provenance about the originating dataset is not otherwise captured in a surrounding Statement. When the AnalysisResult is used as evidence within a Statement, source provenance may already be present on the Statement itself, making this property optional."
      }
   },
   "required": [
      "type",
      "focusVariant",
      "transcriptVariationContext",
      "impactScore"
   ],
   "additionalProperties": false
}
